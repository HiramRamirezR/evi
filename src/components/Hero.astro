---
import config from '../data/config.json';

const msg = encodeURIComponent(
  '¡Hola! Me interesa conocer más sobre la Escuela Montessori "Educación para la Vida". Vengo de su página web y me gustaría recibir información sobre las inscripciones 2026-2027.'
);
const waLink = `https://wa.me/${config.contacto.whatsapp}?text=${msg}`;

const slides = [
  { src: '/images/slide01.webp', alt: 'Educación para la Vida - Escuela Montessori', text: 'Educación para la Vida', tag: 'h1' },
  { src: '/images/slide02.webp', alt: 'Instalaciones - Escuela Montessori', text: 'Escuela Montessori', tag: 'h2' },
  { src: '/images/slide03.webp', alt: 'Fundación 1993 - Escuela Montessori', text: 'Fundada en 1993', tag: 'h2' },
];
---

<div class="hero-slider">
  <div class="hero-slides" id="heroSlides">
    {slides.map((slide, i) => (
      <div class={`hero-slide${i === 0 ? ' active' : ''}`} data-index={i}>
        <img src={slide.src} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="hero-caption">
          <div class="hero-offer-badge">Inscripciones abiertas · Ciclo 2026-2027 · Cupo limitado por grupo</div>
          {slide.tag === 'h1' ? <h1>{slide.text}</h1> : <h2>{slide.text}</h2>}
          <div class="hero-sep">Clave SEP: {config.claveSep}</div>
          <a href={waLink} class="hero-cta" data-wa target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
          <a href={`tel:${config.contacto.telefono}`} class="hero-call">o llama al {config.contacto.telefono}</a>
        </div>
      </div>
    ))}
  </div>
  <div class="hero-dots" id="heroDots">
    {slides.map((_, i) => (
      <button class={`hero-dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Slide ${i + 1}`}></button>
    ))}
  </div>
</div>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  let current = 0;
  let interval;

  function goTo(index) {
    slides.forEach((s, i) => s.classList.toggle('active', i === index));
    dots.forEach((d, i) => d.classList.toggle('active', i === index));
    current = index;
  }

  function next() {
    goTo((current + 1) % slides.length);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      clearInterval(interval);
      goTo(parseInt(dot.dataset.index));
      interval = setInterval(next, 5000);
    });
  });

  interval = setInterval(next, 5000);
</script>