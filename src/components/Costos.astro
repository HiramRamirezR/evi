---
import costos from '../data/costos.json';
---

<div id="costos" class="compatibility">
  <div class="container">
    <h3>Costos - Ciclo Escolar {costos.ciclo}</h3>
    <div style="text-align: center; padding: 2em 0;">
      <p style="font-size: 1.2em; color: #555; margin-bottom: 1em;">
        Mensualidades desde <strong>$3,000</strong>
      </p>
      <p style="color: #888; margin-bottom: 1.5em;">
        Contáctanos para recibir información detallada y personalizada según el nivel de tu hijo.
      </p>
      <button class="open-modal" style="background: #00A2C1; color: #fff; border: none; padding: 14px 36px; border-radius: 30px; font-size: 1.05em; font-weight: 600; cursor: pointer; transition: background 0.3s;"
        onmouseover="this.style.background='#0089a3'" onmouseout="this.style.background='#00A2C1'">
        Solicitar información
      </button>
    </div>
  </div>
</div>
