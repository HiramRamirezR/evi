---
import config from '../data/config.json';

const navItems = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#filosofia', label: 'Filosofía' },
  { href: '#niveles', label: 'Niveles' },
  { href: '#caracteristicas', label: 'Características' },
  { href: '/galeria', label: 'Galería' },
  { href: '#testimonios', label: 'Testimonios' },
  { href: '#horario', label: 'Horario' },
  { href: '#costos', label: 'Costos' },
  { href: '#contacto', label: 'Contacto' },
  { href: '/dia-montessori', label: 'Día Montessori' },
  { href: '/blog', label: 'Blog' },
];
---

<div id="inicio" class="top-header">
  <div class="header" id="mainHeader">
    <div class="container">
      <div class="logo">
        <a href="#"><img src="/images/logo.webp" alt="Educación para la Vida" /></a>
      </div>
      <a href={`tel:${config.contacto.telefono}`} class="header-phone">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="14" height="14" fill="#25D366"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"/></svg>
        <span>{config.contacto.telefono}</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Menú">
        <img src="/images/nav-icon.png" alt="Menú" />
      </button>
      <nav class="top-nav">
        <ul id="navMenu">
          {navItems.map((item) => (
            <li class={item.href === '#inicio' ? 'active' : 'page-scroll'}>
              <a href={item.href} class="scroll">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById('mainHeader');
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');

  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 50);
  });

  if (navToggle && navMenu) {
    navToggle.addEventListener('click', () => {
      navMenu.classList.toggle('open');
    });
  }

  document.querySelectorAll('a.scroll').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      e.preventDefault();
      const target = document.querySelector(href);
      if (target) {
        const offset = header.offsetHeight;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      }
      navMenu.classList.remove('open');
    });
  });
</script>
