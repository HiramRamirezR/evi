---
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/hero.css';
import '../styles/sections.css';
import 'glightbox/dist/css/glightbox.min.css';

import config from '../data/config.json';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
}

const { title, description, ogImage, ogUrl } = Astro.props;
const siteTitle = title || config.site.title;
const siteDesc = description || config.site.description;
const shareImage = ogImage || config.redes.ogImage;
const shareUrl = ogUrl || config.site.url;
const absoluteImage = `${config.site.url}${shareImage}`;

const schoolJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${config.site.url}/#website`,
      url: config.site.url,
      name: 'Educación para la Vida',
      inLanguage: 'es-MX',
      publisher: { '@id': `${config.site.url}/#school` },
    },
    {
      '@type': 'School',
      '@id': `${config.site.url}/#school`,
      name: 'Educación para la Vida',
      description: config.site.description,
      url: config.site.url,
      logo: `${config.site.url}/images/logo.webp`,
      image: absoluteImage,
      telephone: `+52${config.contacto.whatsapp}`,
      email: config.contacto.email,
      foundingDate: '1993',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Ignacio Allende 55, Col. Insurgentes',
        addressLocality: 'Puebla',
        addressRegion: 'Puebla',
        postalCode: '72400',
        addressCountry: 'MX',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: config.site.geo.latitude,
        longitude: config.site.geo.longitude,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '14:00',
        },
      ],
      sameAs: config.redes.facebook ? [config.redes.facebook] : [],
      teaches: ['Kinder', 'Primaria', 'Secundaria'],
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc}>
    <meta name="keywords" content="Escuela Montessori, Educación para la Vida, Kínder, Primaria, Secundaria, Educación activa, Desarrollo infantil, Montessori Puebla, Escuela Montessori Puebla">
    <meta name="author" content={config.site.author}>
    <meta name="theme-color" content="#00A2C1">

    <link rel="canonical" href={shareUrl}>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <meta property="og:type" content="website">
    <meta property="og:url" content={shareUrl}>
    <meta property="og:title" content={siteTitle}>
    <meta property="og:description" content={siteDesc}>
    <meta property="og:image" content={absoluteImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="es_MX">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={siteTitle}>
    <meta name="twitter:description" content={siteDesc}>
    <meta name="twitter:image" content={absoluteImage}>

    <script type="application/ld+json" set:html={JSON.stringify(schoolJsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    {config.analytics?.ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${config.analytics.ga4}`}></script>
        <script is:inline define:vars={{ ga4: config.analytics.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>