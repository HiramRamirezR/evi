---
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/hero.css';
import '../styles/sections.css';
import '../styles/modal.css';
import 'glightbox/dist/css/glightbox.min.css';

import config from '../data/config.json';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
}

const { title, description, ogImage, ogUrl } = Astro.props;
const siteTitle = title || config.site.title;
const siteDesc = description || config.site.description;
const shareImage = ogImage || config.redes.ogImage;
const shareUrl = ogUrl || config.site.url;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc}>
    <meta name="keywords" content="Escuela Montessori, Educación para la Vida, Kínder, Primaria, Secundaria, Educación activa, Desarrollo infantil, Montessori México">
    <meta name="author" content={config.site.author}>

    <meta property="og:type" content="website">
    <meta property="og:url" content={shareUrl}>
    <meta property="og:title" content={siteTitle}>
    <meta property="og:description" content={siteDesc}>
    <meta property="og:image" content={`${config.site.url}${shareImage}`}>
    <meta property="og:locale" content="es_MX">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={siteTitle}>
    <meta name="twitter:description" content={siteDesc}>
    <meta name="twitter:image" content={`${config.site.url}${shareImage}`}>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Educación para la Vida",
      "description": config.site.description,
      "url": config.site.url,
      "telephone": config.contacto.telefono,
      "email": config.contacto.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ignacio Allende 55",
        "addressLocality": "Puebla",
        "addressRegion": "Puebla",
        "addressCountry": "MX"
      },
      "foundingDate": "1993",
      "teaches": ["Kinder", "Primaria", "Secundaria"]
    })} />

    <link rel="icon" type="image/png" href="/images/logo.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    {config.analytics?.ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${config.analytics.ga4}`}></script>
        <script is:inline define:vars={{ ga4: config.analytics.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
