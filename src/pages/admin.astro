---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminLogin from '../components/AdminLogin.astro';
import AdminPanel from '../components/AdminPanel.astro';
import MenuCalendar from '../components/MenuCalendar.astro';
import EntregaApp from '../components/EntregaApp.astro';
import '../styles/admin.css';
---

<BaseLayout title="Admin - Educación para la Vida" description="Panel de administración">
  <script is:inline>
    window.FIREBASE_CONFIG = {
      apiKey: "AIzaSyAl9lvO43hnZ0qCZPoUmUm4-pfmlboXXs8",
      authDomain: "evi1-39416.firebaseapp.com",
      databaseURL: "https://evi1-39416-default-rtdb.firebaseio.com",
      projectId: "evi1-39416",
      storageBucket: "evi1-39416.firebasestorage.app",
      messagingSenderId: "920315618667",
      appId: "1:920315618667:web:f647b8655561a3560f582e"
    };
  </script>
  <script is:inline src="https://unpkg.com/jspdf@latest/dist/jspdf.umd.min.js"></script>
  <div id="adminRoot">
    <AdminLogin />
    <AdminPanel />
    <MenuCalendar />
    <EntregaApp />
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    const isAuthenticated = localStorage.getItem('evi_admin_auth') === 'true';
    const login = document.querySelector('.admin-login');
    const panel = document.querySelector('.admin-panel');
    const calendar = document.querySelector('.menu-calendar');
    const entregaApp = document.querySelector('.entrega-app');

    if (isAuthenticated) {
      login.style.display = 'none';
      panel.style.display = 'block';
      calendar.style.display = 'none';
      if (entregaApp) entregaApp.style.display = 'none';
    } else {
      login.style.display = 'flex';
      panel.style.display = 'none';
      calendar.style.display = 'none';
      if (entregaApp) entregaApp.style.display = 'none';
    }

    var openCal = document.getElementById('openCalendar');
    if (openCal) {
      openCal.addEventListener('click', function() {
        panel.style.display = 'none';
        calendar.style.display = 'block';
        if (entregaApp) entregaApp.style.display = 'none';
      });
    }

    var openEntregaApp = document.getElementById('openEntregaApp');
    if (openEntregaApp) {
      openEntregaApp.addEventListener('click', function() {
        panel.style.display = 'none';
        calendar.style.display = 'none';
        if (entregaApp) {
          entregaApp.style.display = 'block';
          document.getElementById('entregaModeSelect').style.display = 'flex';
          document.getElementById('entregaControl').style.display = 'none';
          document.getElementById('salonControl').style.display = 'none';
          document.getElementById('entregaSettingsPanel').style.display = 'none';
        }
      });
    }
  })();
</script>
